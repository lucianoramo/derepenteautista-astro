---
interface Props {
  src: string;
}

const { src } = Astro.props;
---
<div class="my-6 bg-surface rounded-lg p-4 border border-gray-200">
  <p class="text-sm text-muted mb-2"><i class="fas fa-headphones mr-2 text-accent"></i>Entrevista em áudio:</p>
  <audio controls class="w-full">
    <source src={src} type="audio/mpeg" />
    Seu navegador não suporta o elemento de áudio.
  </audio>
  <a href={src} download class="text-xs text-accent hover:underline mt-2 inline-block">
    <i class="fas fa-download mr-1"></i>Baixar o áudio
  </a>
</div>
