---
const year = new Date().getFullYear();
---
<footer class="border-t-4 border-accent mt-12 bg-dark text-white">
  <div class="max-w-5xl mx-auto px-4 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-sm text-gray-300">© {year}, Todos os direitos reservados</p>
    <div class="flex gap-4 text-lg">
      <a href="/feed/" class="hover:text-accent transition-colors" aria-label="RSS">
        <i class="fa fa-rss"></i>
      </a>
      <a href="https://www.facebook.com/www.derepenteautista.com.br/" target="_blank" rel="noopener" class="hover:text-accent transition-colors" aria-label="Facebook">
        <i class="fab fa-facebook"></i>
      </a>
      <a href="https://instagram.com/derepenteautista" target="_blank" rel="noopener" class="hover:text-accent transition-colors" aria-label="Instagram">
        <i class="fab fa-instagram"></i>
      </a>
    </div>
    <p class="text-sm text-gray-400">Designed by <a href="#" class="hover:text-accent">Luciano Ramo</a></p>
  </div>
</footer>
