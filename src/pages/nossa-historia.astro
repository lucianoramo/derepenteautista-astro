---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Nossa História" description="Nossa História - De repente autista">
  <Header />
  <main class="max-w-3xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-dark mb-6">Nossa História</h1>
    <div class="prose prose-lg max-w-none">
      <p>Esta página reúne os artigos e histórias do blog De repente autista, compartilhando o percurso de Michelle Carvalho e seu filho Enzo.</p>
    </div>
  </main>
  <Footer />
</Base>
