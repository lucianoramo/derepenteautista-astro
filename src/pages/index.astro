---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import PostCard from '../components/PostCard.astro';

const POSTS_PER_PAGE = 10;

const allPosts = await getCollection('posts');
const sorted = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const posts = sorted.slice(0, POSTS_PER_PAGE);
const totalPages = Math.ceil(sorted.length / POSTS_PER_PAGE);
---
<Base title="De repente autista">
  <Header />
  <div class="max-w-5xl mx-auto px-4 py-8">
    <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-8">
      <main>
        <div class="grid sm:grid-cols-2 gap-6">
          {posts.map(post => (
            <PostCard
              title={post.data.title}
              slug={post.slug}
              date={post.data.date}
              image={post.data.image}
              description={post.data.description}
              author={post.data.author}
              categories={post.data.categories}
            />
          ))}
        </div>
        {totalPages > 1 && (
          <div class="mt-8 flex justify-between items-center">
            <span class="text-sm text-muted">Página 1 de {totalPages}</span>
            <a href="/page/2" class="bg-accent text-white px-4 py-2 rounded hover:bg-blue-500 transition-colors text-sm font-semibold">
              Próxima →
            </a>
          </div>
        )}
      </main>
      <div class="mt-10 lg:mt-0">
        <Sidebar />
      </div>
    </div>
  </div>
  <Footer />
</Base>
